# ---------------------------------------------------------------------------
# ZENITH — configuration. Copy this file to ".env" and fill in your values.
# Nothing here is ever committed; .env is git-ignored.
# ---------------------------------------------------------------------------

# --- AI brain (required) -----------------------------------------------------
# Any OpenAI-compatible chat completions provider works:
#   OpenAI, Groq, Together, DeepInfra, OpenRouter, Mistral, LM Studio, Ollama
# The default above talks to OpenAI. For a local Ollama server use:
#   ZENITH_LLM_BASE_URL=http://127.0.0.1:11434/v1  (no key needed)
ZENITH_LLM_PROVIDER=openai
ZENITH_LLM_BASE_URL=https://api.openai.com/v1
ZENITH_LLM_API_KEY=                       # your provider key
ZENITH_LLM_MODEL=gpt-4o-mini
# Optional brain tuning:
# ZENITH_LLM_TEMPERATURE=0.75
# ZENITH_LLM_MAX_TOKENS=1024
# ZENITH_LLM_TIMEOUT_MS=120000
# ZENITH_LLM_RETRIES=1

# --- Voice (ElevenLabs, optional but recommended) -----------------------------
# Without this, ZENITH speaks with the local browser voice (still fully working).
ELEVENLABS_API_KEY=                       # your ElevenLabs key
ELEVENLABS_VOICE_ID=                       # pick one in Settings or via ElevenLabs
# Optional voice budget guardrails:
# ELEVENLABS_MONTHLY_CHARS_CAP=18000
# ELEVENLABS_TURN_CHARS_CAP=420

# --- Speech-to-text (recommended; falls back to the browser's speech engine) --
# Any OpenAI-compatible transcription endpoint works. Defaults to OpenAI Whisper.
ZENITH_STT_BASE_URL=https://api.openai.com/v1
ZENITH_STT_API_KEY=                        # defaults to ZENITH_LLM_API_KEY / OPENAI_API_KEY
ZENITH_STT_MODEL=whisper-1
# ZENITH_STT_LANGUAGE=                     # empty = auto-detect
# ZENITH_STT_TIMEOUT_MS=60000

# --- Backend -----------------------------------------------------------------
# ZENITH_PORT=4567
# ZENITH_HOST=127.0.0.1
# ZENITH_LOG_LEVEL=info

# --- Data directory (rarely changed; defaults to ./data) ----------------------
# ZENITH_DATA_DIR=data
